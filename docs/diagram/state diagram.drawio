        <mxCell id="ct_e0" edge="1" parent="1" source="ct_init" style="html=1;endArrow=open;endSize=10;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="ct_E" value="">
