          <mxGeometry relative="1" as="geometry" />
        </mxCell><mxCell id="us_e11" value="게임 폐기&lt;br&gt;(다른 참가자 불참 신고)" style="html=1;endArrow=open;endSize=10;fontSize=11;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="us_P" target="us_Q"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="840" y="455"/><mxPoint x="840" y="135"/></Array></mxGeometry></mxCell>
