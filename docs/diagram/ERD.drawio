Dx=0;entryDy=0;" edge="1" parent="1" source="games" target="queue_entries"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endSize=12;startSize=12;startArrow=ERmandOne;endArrow=ERzeroToMany;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gyms" target="games"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endSize=12;startSize=12;startArrow=ERzeroToOne;endArrow=ERzeroToMany;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="courts" target="games"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1050" y="390"/><mxPoint x="892" y="390"/></Array></mxGeometry></mxCell><mxCell id="r11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endSize=12;startSize=12;startArrow=ERmandOne;endArrow=ERmany;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="games" target="game_players"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endSize=12;startSize=12;startArrow=ERmandOne;endArrow=ERzeroToMany;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="users" target="game_players"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="165" y="30"/><mxPoint x="1290" y="30"/><mxPoint x="1290" y="472"/></Array></mxGeometry></mxCell><mxCell id="r13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endSize=12;startSize=12;startArrow=ERmandOne;endArrow=ERzeroToMany;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="games" target="score_submissions"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endSize=12;startSize=12;startArrow=ERmandOne;endArrow=ERzeroToMany;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="users" target="score_submissions"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="15"/><mxPoint x="1310" y="15"/><mxPoint x="1310" y="738"/></Array></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;상태(ENUM) 값 ↔ 상태 다이어그램&lt;/b&gt;&lt;br&gt;• check_ins.status: RESTING(휴식) / QUEUED(매칭 대기) / MATCHED(매칭됨) / PLAYING(게임 중) / AWAITING_RESULT(결과 입력 중) / CHECKED_OUT(체크아웃)&lt;br&gt;• games.status: WAITING_COURT(코트 대기) / IN_PROGRESS(진행 중) / COLLECTING_SCORES(점수 입력 대기) / DISPUTED(불일치 수정 대기) / CONFIRMED(확정) / VOIDED(무효) / CANCELLED(해체)&lt;br&gt;• courts.status: AVAILABLE(비어 있음) / IN_USE(사용 중)&lt;br&gt;• queue_entries.status: WAITING / MATCHED / CANCELLED&lt;br&gt;• mode: MEN_DOUBLES(남복) / WOMEN_DOUBLES(여복) / MIXED_DOUBLES(혼복) / ANY(성별 무관)&lt;br&gt;• gender: MALE / FEMALE &amp;nbsp;&amp;nbsp;• grade: BEGINNER / D / C / B / A (가입 시 1회 입력, 수정 불가) &amp;nbsp;• mmr 초기값 = 급수별 기준값&lt;br&gt;&lt;br&gt;&lt;b&gt;타이머 기준 컬럼&lt;/b&gt;&lt;br&gt;• 불참 신고 가능(시작 후 3~10분) &amp;nbsp;• 40분 초과: games.started_at &amp;nbsp;• 첫 제출 후 10분: games.ended_at &amp;nbsp;• 90분 활동 없음: check_ins.last_active_at (체크인·매칭 시작·게임 시작 때 갱신)&lt;br&gt;&lt;br&gt;&lt;b&gt;제약 조건&lt;/b&gt;&lt;br&gt;• check_ins: 사용자당 활성 체크인(checked_out_at IS NULL)은 1개만&lt;br&gt;• courts: UNIQUE(gym_id, court_number) &amp;nbsp;• score_submissions: UNIQUE(game_id, user_id) → 수정 대기 중엔 UPDATE&lt;br&gt;• 상태 변경은 조건부 UPDATE (… WHERE status = '이전 상태') 로 동시 요청 중 하나만 성공" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=8;strokeColor=#999999;fillColor=#fafafa;rounded=1;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="1210" height="250" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>